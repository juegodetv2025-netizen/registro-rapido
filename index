<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Registro rápido de día laborado · LICONSUMAR</title>
<meta name="robots" content="noindex, nofollow">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

<style>
:root{
  --navy:#12283f;
  --navy-2:#0c1c2e;
  --accent:#f2994a;
  --accent-dark:#d97e34;
  --paper:#f5f3ee;
  --card:#ffffff;
  --ink:#1b232c;
  --ink-soft:#5b6673;
  --line:#e1dccd;
  --line-strong:#c9c2ac;
  --success:#2f9e63;
  --danger:#d1495b;
  --radius:10px;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:
    radial-gradient(circle at 15% 0%, rgba(242,153,74,0.14), transparent 45%),
    radial-gradient(circle at 90% 90%, rgba(18,40,63,0.12), transparent 45%),
    var(--paper);
  color:var(--ink);
  font-family:'Inter',sans-serif;
  min-height:100vh;
}
h1,h2,h3,.brand{font-family:'Space Grotesk',sans-serif;}
.mono{font-family:'IBM Plex Mono',monospace;}
button{font-family:inherit;cursor:pointer;}
input,select,textarea{font-family:inherit;}

.wrap{max-width:560px;margin:0 auto;padding:22px 16px 60px;}
.topbar{text-align:center;padding:18px 0 6px;}
.topbar .platenum{
  font-family:'IBM Plex Mono',monospace;letter-spacing:3px;font-weight:600;
  background:var(--navy);color:#fff;display:inline-block;padding:6px 12px;border-radius:5px;font-size:11.5px;
}
.topbar h1{font-size:19px;margin:10px 0 2px;}
.topbar p{color:var(--ink-soft);font-size:12.5px;margin:0;}

.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-top:16px;}
.card h3{margin:0 0 14px;font-size:15px;}
.field{margin-bottom:14px;}
.field label{display:block;font-size:12.5px;font-weight:600;color:var(--ink-soft);margin-bottom:5px;letter-spacing:.2px;}
.field input,.field select{
  width:100%;padding:11px 12px;border:1px solid var(--line-strong);border-radius:8px;
  font-size:15px;background:#fff;color:var(--ink);
}
.field input:focus,.field select:focus{outline:2px solid var(--accent);border-color:var(--accent);}
.field input:disabled{background:#f1efe7;color:var(--ink-soft);}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
@media (max-width:480px){.grid2{grid-template-columns:1fr;}}

.btn{
  border:none;border-radius:8px;padding:13px 18px;font-weight:600;font-size:15px;
  display:inline-flex;align-items:center;gap:8px;justify-content:center;transition:transform .05s ease;width:100%;
}
.btn:active{transform:scale(0.98);}
.btn-primary{background:var(--accent);color:#211200;}
.btn-primary:hover{background:var(--accent-dark);}
.btn-navy{background:var(--navy);color:#fff;}
.btn-navy:hover{background:var(--navy-2);}
.btn-ghost{background:transparent;color:var(--navy);border:1px solid var(--line-strong);}
.btn-ghost:hover{background:#efeadd;}
.btn-sm{padding:8px 10px;font-size:12.5px;width:auto;}

.aux-chip{
  display:flex;align-items:center;gap:10px;background:#eef3f8;border:1px solid #d7e2ec;border-radius:10px;
  padding:12px 14px;margin-bottom:16px;
}
.aux-chip .av{
  width:38px;height:38px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;
  justify-content:center;font-weight:700;font-size:15px;flex-shrink:0;
}
.aux-chip .nm{font-weight:700;font-size:14px;}
.aux-chip .cc{color:var(--ink-soft);font-size:12px;font-family:'IBM Plex Mono',monospace;}
.aux-chip .chg{margin-left:auto;}

.inline-add{display:flex;gap:6px;margin-top:6px;}
.inline-add input{flex:1;}
.hidden{display:none !important;}
.product-row{display:grid;grid-template-columns:2fr 1fr auto;gap:8px;margin-bottom:8px;align-items:center;}

.sigwrap{border:1.5px dashed var(--line-strong);border-radius:8px;background:#fcfbf7;position:relative;}
.sigwrap canvas{width:100%;height:140px;display:block;touch-action:none;border-radius:8px;}
.sig-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:6px;}
.sig-hint{position:absolute;bottom:8px;left:12px;color:#b9b2a0;font-size:12px;pointer-events:none;}

.msg-error{background:#fbe7e9;color:var(--danger);border-radius:8px;padding:12px 14px;font-size:13.5px;margin-top:10px;}
.msg-ok{background:#e4f5eb;color:var(--success);border-radius:8px;padding:14px;font-size:14px;text-align:center;font-weight:600;}
.small-note{font-size:12px;color:var(--ink-soft);margin-top:4px;}

#toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);z-index:2000;display:flex;flex-direction:column;gap:8px;width:calc(100% - 32px);max-width:520px;}
.toast-msg{background:var(--navy);color:#fff;padding:12px 16px;border-radius:8px;font-size:13.5px;box-shadow:0 8px 20px rgba(0,0,0,0.25);text-align:center;}
.toast-msg.err{background:var(--danger);}
.toast-msg.ok{background:var(--success);}

.spinner{display:inline-block;width:15px;height:15px;border:2px solid rgba(0,0,0,0.2);border-top-color:var(--navy);border-radius:50%;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
</style>
</head>
<body>

<div class="wrap">
  <div class="topbar">
    <span class="platenum">RUTA · CUADRE · COBRO</span>
    <h1>Registro rápido de día laborado</h1>
    <p>Escanea, escribe tu cédula y registra tu día en segundos.</p>
  </div>

  <!-- PASO 1: IDENTIFICACIÓN POR CÉDULA -->
  <div class="card" id="card-identidad">
    <h3>1. Identifícate</h3>
    <div class="field">
      <label>Número de cédula</label>
      <input id="qr-cedula" inputmode="numeric" placeholder="Ej. 1082345678" autofocus>
    </div>
    <button class="btn btn-primary" id="btn-buscar" onclick="Kiosk.buscarAuxiliar()">Buscar mis datos</button>
    <div id="identidad-msg"></div>
  </div>

  <!-- PASO 2: FORMULARIO DE DÍA LABORADO (mismo formulario del app) -->
  <div class="card hidden" id="card-formulario">
    <div class="aux-chip">
      <div class="av" id="aux-avatar">?</div>
      <div>
        <div class="nm" id="aux-nombre">-</div>
        <div class="cc" id="aux-cedula-txt">CC -</div>
      </div>
      <button class="btn btn-ghost btn-sm chg" onclick="Kiosk.cambiarCedula()">Cambiar</button>
    </div>

    <h3>2. Nuevo día laborado</h3>
    <div class="grid2">
      <div class="field"><label>Fecha</label><input type="date" id="rf-fecha"></div>
      <div class="field"><label>Placa</label>
        <select id="rf-placa" onchange="Kiosk.maybeInlineAdd('placa')"></select>
        <div class="inline-add hidden" id="add-placa-wrap"><input id="add-placa-input" placeholder="Nueva placa"><button class="btn btn-navy btn-sm" onclick="Kiosk.inlineSave('placas','placa','add-placa-input','rf-placa')">Guardar</button></div>
      </div>
    </div>

    <div class="field"><label>¿Es estampillado o ruta?</label>
      <select id="rf-concepto" onchange="Kiosk.onConceptoChange()">
        <option value="Ruta">Ruta</option>
        <option value="Estampillado">Estampillado</option>
      </select>
    </div>

    <div id="ruta-block">
      <div class="grid2">
        <div class="field"><label>Tipo de ruta</label>
          <select id="rf-tiposervicio" onchange="Kiosk.maybeInlineAdd('tiposervicio'); Kiosk.recalcValor();"></select>
          <div class="inline-add hidden" id="add-tiposervicio-wrap"><input id="add-tiposervicio-input" placeholder="Nuevo tipo de ruta"><button class="btn btn-navy btn-sm" onclick="Kiosk.inlineSave('tipos_servicio','nombre','add-tiposervicio-input','rf-tiposervicio')">Guardar</button></div>
        </div>
        <div class="field"><label>Conductor</label>
          <select id="rf-conductor" onchange="Kiosk.maybeInlineAdd('conductor'); Kiosk.recalcValor();"></select>
          <div class="inline-add hidden" id="add-conductor-wrap"><input id="add-conductor-input" placeholder="Nuevo conductor"><button class="btn btn-navy btn-sm" onclick="Kiosk.inlineSaveConductor()">Guardar</button></div>
        </div>
      </div>
    </div>

    <div id="estampillado-block" class="hidden">
      <label style="display:block;font-size:12.5px;font-weight:600;color:var(--ink-soft);margin-bottom:6px;">Productos estampillados (valor de la estampilla: $28 c/u)</label>
      <div id="productos-rows"></div>
      <button class="btn btn-ghost btn-sm" style="width:auto;" onclick="Kiosk.addProductoRow()">+ Agregar producto</button>
    </div>

    <div class="field" style="margin-top:14px;"><label>Valor del día</label><input id="rf-valor" class="mono" value="0" disabled></div>

    <div class="field"><label>Ciudad / población de entrega</label>
      <select id="rf-ciudad" onchange="Kiosk.maybeInlineAdd('ciudad')"></select>
      <div class="inline-add hidden" id="add-ciudad-wrap"><input id="add-ciudad-input" placeholder="Nueva ciudad/población"><button class="btn btn-navy btn-sm" onclick="Kiosk.inlineSave('ciudades','nombre','add-ciudad-input','rf-ciudad')">Guardar</button></div>
    </div>

    <div class="field">
      <label>Firma digital del reporte del día</label>
      <div class="sigwrap"><canvas id="rf-sig-canvas"></canvas><span class="sig-hint">Firma aquí con el dedo</span></div>
      <div class="sig-actions"><button class="btn btn-ghost btn-sm" onclick="SigPadRef.clear()">Borrar firma</button></div>
    </div>

    <button class="btn btn-primary" id="btn-guardar" onclick="Kiosk.guardarRegistro()">Guardar registro</button>
  </div>

  <!-- PASO 3: CONFIRMACIÓN -->
  <div class="card hidden" id="card-exito">
    <div class="msg-ok" id="exito-msg">Registro guardado correctamente ✅</div>
    <button class="btn btn-navy" style="margin-top:14px;" onclick="Kiosk.registrarOtro()">Registrar otro día</button>
  </div>

  <div id="toast"></div>
</div>

<script>
/* ============================================================
   CONFIGURACIÓN SUPABASE (misma base de datos de la app principal)
   ============================================================ */
const SUPABASE_URL = "https://phomutbqbyxeotidwbyy.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBob211dGJxYnl4ZW90aWR3Ynl5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMzczMTUsImV4cCI6MjEwMzYxMzMxNX0.mnpgXygyDqcay8paXGCoCoLtCeqq8lkzpo7uoq8Kvbg";
const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

const CARGUE_POBLACIONES = 'CARGUE POBLACIONES';
const CARGUE_POBLACIONES_VALOR = 28000;

/* ============================================================
   UTILIDADES
   ============================================================ */
function esc(s){ return (s==null?'':String(s)).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function todayISO(){ return new Date().toISOString().slice(0,10); }
function toast(msg, type){
  const el=document.createElement('div');
  el.className='toast-msg'+(type?(' '+type):'');
  el.textContent=msg;
  document.getElementById('toast').appendChild(el);
  setTimeout(()=>el.remove(), 4200);
}
function initials(nombre){
  if(!nombre) return '?';
  return nombre.trim().split(/\s+/).slice(0,2).map(w=>w[0]).join('').toUpperCase();
}

/* ============================================================
   FIRMA DIGITAL (canvas) — igual que en la app principal
   ============================================================ */
class SigPad{
  constructor(canvas){
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.drawing = false;
    this.hasInk = false;
    this._resize();
    window.addEventListener('resize', ()=>this._resize());
    const start = e=>{ this.drawing=true; this._point(e); };
    const move = e=>{ if(this.drawing){ this._line(e); e.preventDefault(); } };
    const end = ()=>{ this.drawing=false; this.ctx.beginPath(); };
    canvas.addEventListener('mousedown', start);
    canvas.addEventListener('mousemove', move);
    window.addEventListener('mouseup', end);
    canvas.addEventListener('touchstart', start, {passive:false});
    canvas.addEventListener('touchmove', move, {passive:false});
    canvas.addEventListener('touchend', end);
  }
  _resize(){
    const rect = this.canvas.getBoundingClientRect();
    const ratio = window.devicePixelRatio||1;
    this.canvas.width = rect.width*ratio;
    this.canvas.height = rect.height*ratio;
    this.ctx.scale(ratio,ratio);
    this.ctx.lineWidth=2.2; this.ctx.lineCap='round'; this.ctx.strokeStyle='#12283f';
  }
  _pos(e){
    const rect=this.canvas.getBoundingClientRect();
    const p = e.touches? e.touches[0]:e;
    return {x:p.clientX-rect.left, y:p.clientY-rect.top};
  }
  _point(e){ const p=this._pos(e); this.ctx.beginPath(); this.ctx.moveTo(p.x,p.y); this.hasInk=true; }
  _line(e){ const p=this._pos(e); this.ctx.lineTo(p.x,p.y); this.ctx.stroke(); this.hasInk=true; }
  clear(){ this.ctx.clearRect(0,0,this.canvas.width,this.canvas.height); this.hasInk=false; }
  toDataURL(){ return this.hasInk ? this.canvas.toDataURL('image/png') : ''; }
}
let SigPadRef = null;

/* ============================================================
   KIOSCO DE REGISTRO RÁPIDO
   ============================================================ */
const Kiosk = {
  auxiliar: null,
  catalogos: { placas:[], conductores:[], tipos_servicio:[], ciudades:[] },
  productosEstampillado: [],

  async loadCatalogos(){
    const [p,c,t,ci] = await Promise.all([
      sb.from('placas').select('*').order('placa'),
      sb.from('conductores').select('*').order('nombre'),
      sb.from('tipos_servicio').select('*').order('nombre'),
      sb.from('ciudades').select('*').order('nombre')
    ]);
    this.catalogos.placas = p.data||[];
    this.catalogos.conductores = c.data||[];
    this.catalogos.tipos_servicio = t.data||[];
    this.catalogos.ciudades = ci.data||[];
  },

  async buscarAuxiliar(){
    const cedula = document.getElementById('qr-cedula').value.trim();
    const msgBox = document.getElementById('identidad-msg');
    const btn = document.getElementById('btn-buscar');
    msgBox.innerHTML = '';
    if(!cedula){ toast('Escribe tu número de cédula','err'); return; }

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> Buscando…';
    const { data, error } = await sb.from('auxiliares').select('*').eq('cedula', cedula).maybeSingle();
    btn.disabled = false;
    btn.textContent = 'Buscar mis datos';

    if(error || !data){
      msgBox.innerHTML = `<div class="msg-error">No encontramos un auxiliar con esa cédula. Debes crear tu cuenta primero desde la app principal antes de usar el registro rápido.</div>`;
      return;
    }
    this.auxiliar = data;
    await this.loadCatalogos();
    this.mostrarFormulario();
  },

  cambiarCedula(){
    this.auxiliar = null;
    document.getElementById('qr-cedula').value = '';
    document.getElementById('identidad-msg').innerHTML = '';
    document.getElementById('card-formulario').classList.add('hidden');
    document.getElementById('card-identidad').classList.remove('hidden');
    document.getElementById('qr-cedula').focus();
  },

  mostrarFormulario(){
    const a = this.auxiliar;
    document.getElementById('aux-nombre').textContent = a.nombre_completo || 'Sin nombre registrado';
    document.getElementById('aux-cedula-txt').textContent = 'CC ' + a.cedula;
    document.getElementById('aux-avatar').textContent = initials(a.nombre_completo || a.cedula);

    document.getElementById('rf-fecha').value = todayISO();
    this.productosEstampillado = [];
    document.getElementById('rf-concepto').value = 'Ruta';

    this.fillSelect('rf-placa', this.catalogos.placas, 'placa');
    this.fillSelect('rf-tiposervicio', this.catalogos.tipos_servicio, 'nombre');
    this.fillConductorSelect();
    this.fillSelect('rf-ciudad', this.catalogos.ciudades, 'nombre');

    document.getElementById('card-identidad').classList.add('hidden');
    document.getElementById('card-exito').classList.add('hidden');
    document.getElementById('card-formulario').classList.remove('hidden');

    this.onConceptoChange();
    setTimeout(()=>{ SigPadRef = new SigPad(document.getElementById('rf-sig-canvas')); }, 30);
  },

  fillSelect(id, arr, field){
    const sel = document.getElementById(id);
    sel.innerHTML = arr.map(o=>`<option value="${esc(o[field])}">${esc(o[field])}</option>`).join('') + `<option value="__nuevo__">+ Agregar nueva opción…</option>`;
  },
  fillConductorSelect(){
    const sel = document.getElementById('rf-conductor');
    sel.innerHTML = `<option value="Ninguno" selected>Ninguno</option>` +
      this.catalogos.conductores.map(o=>`<option value="${esc(o.nombre)}">${esc(o.nombre)}</option>`).join('') +
      `<option value="__nuevo__">+ Agregar nueva opción…</option>`;
  },

  maybeInlineAdd(kind){
    const map = { placa:'rf-placa', tiposervicio:'rf-tiposervicio', conductor:'rf-conductor', ciudad:'rf-ciudad' };
    const sel = document.getElementById(map[kind]);
    document.getElementById('add-'+kind+'-wrap').classList.toggle('hidden', sel.value!=='__nuevo__');
  },
  async inlineSave(table, field, inputId, selectId){
    const val = document.getElementById(inputId).value.trim();
    if(!val){ toast('Escribe un valor','err'); return; }
    const payload={}; payload[field]=val;
    const { error } = await sb.from(table).insert(payload);
    if(error){ toast('No se pudo agregar','err'); return; }
    await this.loadCatalogos();
    const sel = document.getElementById(selectId);
    const opt = document.createElement('option');
    opt.value = val; opt.textContent = val;
    sel.insertBefore(opt, sel.lastElementChild);
    sel.value = val;
    document.getElementById(inputId.replace('-input','-wrap')).classList.add('hidden');
    toast('Agregado','ok');
    if(selectId==='rf-conductor') this.recalcValor();
  },
  async inlineSaveConductor(){
    const val = document.getElementById('add-conductor-input').value.trim();
    if(!val){ toast('Escribe un nombre','err'); return; }
    const { error } = await sb.from('conductores').insert({nombre:val, valor_dia:80000});
    if(error){ toast('No se pudo agregar','err'); return; }
    await this.loadCatalogos();
    const sel = document.getElementById('rf-conductor');
    const opt = document.createElement('option');
    opt.value = val; opt.textContent = val;
    sel.insertBefore(opt, sel.lastElementChild);
    sel.value = val;
    document.getElementById('add-conductor-wrap').classList.add('hidden');
    this.recalcValor();
    toast('Conductor agregado (valor $80.000)','ok');
  },

  onConceptoChange(){
    const esEstampillado = document.getElementById('rf-concepto').value==='Estampillado';
    document.getElementById('estampillado-block').classList.toggle('hidden', !esEstampillado);
    document.getElementById('ruta-block').classList.toggle('hidden', esEstampillado);
    if(esEstampillado && !this.productosEstampillado.length){ this.productosEstampillado=[{referencia:'',cantidad:1}]; this.renderProductoRows(); }
    this.recalcValor();
  },
  recalcValor(){
    const concepto = document.getElementById('rf-concepto').value;
    let valor = 0;
    if(concepto==='Estampillado'){
      valor = this.productosEstampillado.reduce((s,p)=> s + (Number(p.cantidad)||0)*28, 0);
    } else {
      const tiposervicioEl = document.getElementById('rf-tiposervicio');
      const tipoServicio = tiposervicioEl ? tiposervicioEl.value : '';
      if((tipoServicio||'').trim().toUpperCase()===CARGUE_POBLACIONES){
        valor = CARGUE_POBLACIONES_VALOR;
      } else {
        const nombre = document.getElementById('rf-conductor').value;
        if(nombre==='Ninguno' || nombre==='__nuevo__' || !nombre){
          valor = 0;
        } else {
          const found = this.catalogos.conductores.find(c=>c.nombre===nombre);
          valor = found ? Number(found.valor_dia) : 80000;
        }
      }
    }
    document.getElementById('rf-valor').value = valor;
  },
  addProductoRow(){
    this.productosEstampillado.push({referencia:'',cantidad:1});
    this.renderProductoRows();
    this.recalcValor();
  },
  renderProductoRows(){
    const wrap = document.getElementById('productos-rows');
    if(!wrap) return;
    wrap.innerHTML = this.productosEstampillado.map((p,i)=>`
      <div class="product-row">
        <input placeholder="Referencia / producto" value="${esc(p.referencia)}" oninput="Kiosk.productosEstampillado[${i}].referencia=this.value">
        <input type="number" min="1" placeholder="Cant." value="${p.cantidad}" oninput="Kiosk.productosEstampillado[${i}].cantidad=this.value; Kiosk.recalcValor();">
        <button class="btn btn-danger btn-sm" style="width:auto;" onclick="Kiosk.removeProductoRow(${i})">✕</button>
      </div>`).join('');
  },
  removeProductoRow(i){
    this.productosEstampillado.splice(i,1);
    this.renderProductoRows();
    this.recalcValor();
  },

  async guardarRegistro(){
    const fecha = document.getElementById('rf-fecha').value;
    const placa = document.getElementById('rf-placa').value;
    const concepto = document.getElementById('rf-concepto').value;
    const ciudad = document.getElementById('rf-ciudad').value;
    const esEstampillado = concepto==='Estampillado';

    let conductor = 'Ninguno', tipo_servicio = '-';
    if(!esEstampillado){
      conductor = document.getElementById('rf-conductor').value;
      tipo_servicio = document.getElementById('rf-tiposervicio').value;
    }

    if([placa,ciudad].includes('__nuevo__') || (!esEstampillado && [conductor,tipo_servicio].includes('__nuevo__'))){
      toast('Guarda las opciones nuevas antes de continuar','err'); return;
    }
    if(!fecha || !placa || !ciudad){ toast('Completa todos los campos','err'); return; }
    if(!esEstampillado && (!conductor || !tipo_servicio)){ toast('Completa el tipo de ruta y el conductor','err'); return; }

    let productos = [];
    if(esEstampillado){
      productos = this.productosEstampillado.filter(p=>p.referencia && Number(p.cantidad)>0);
      if(!productos.length){ toast('Agrega al menos un producto estampillado con cantidad','err'); return; }
    }

    const valor = Number(document.getElementById('rf-valor').value)||0;
    const firma = SigPadRef ? SigPadRef.toDataURL() : '';

    let actividad;
    if(esEstampillado){
      actividad = 'Estampillado (' + productos.map(p=>`${p.referencia} x${p.cantidad}`).join(', ') + `) - ${ciudad}`;
    } else {
      actividad = `${tipo_servicio} - ${ciudad}`;
    }

    const payload = {
      auxiliar_id: this.auxiliar.id, fecha, placa, conductor, valor, tipo_servicio, concepto,
      productos, ciudad, actividad, firma, es_descuento:false, creado_por:'qr-kiosco'
    };

    const btn = document.getElementById('btn-guardar');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> Guardando…';
    const { error } = await sb.from('registros').insert(payload);
    btn.disabled = false;
    btn.textContent = 'Guardar registro';

    if(error){ toast('No se pudo guardar el registro','err'); return; }

    document.getElementById('exito-msg').innerHTML =
      `Día laborado registrado correctamente para <b>${esc(this.auxiliar.nombre_completo||this.auxiliar.cedula)}</b> ✅`;
    document.getElementById('card-formulario').classList.add('hidden');
    document.getElementById('card-exito').classList.remove('hidden');
  },

  registrarOtro(){
    this.auxiliar = null;
    document.getElementById('qr-cedula').value = '';
    document.getElementById('identidad-msg').innerHTML = '';
    document.getElementById('card-exito').classList.add('hidden');
    document.getElementById('card-identidad').classList.remove('hidden');
    document.getElementById('qr-cedula').focus();
  }
};

document.getElementById('qr-cedula').addEventListener('keydown', e=>{
  if(e.key==='Enter') Kiosk.buscarAuxiliar();
});
</script>
</body>
</html>
